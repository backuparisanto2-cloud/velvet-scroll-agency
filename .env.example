# ============================================================
# CHECKLIST VARIABEL LINGKUNGAN — Build & Deploy NGINX
# Isi semua yang bertanda [WAJIB] sebelum menjalankan build
# atau deploy agar tidak error di runtime.
# ============================================================

# [WAJIB] Supabase — dibaca oleh server-side analytics & SSR
# Dapatkan dari project Supabase / Lovable Cloud:
#   SUPABASE_URL            → Project Settings → API → Project URL
#   SUPABASE_PUBLISHABLE_KEY→ Project Settings → API → Project API keys → anon/public
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [WAJIB] Vite client-side Supabase (ter-bundle ke browser)
# Untuk situs ini isi dengan nilai yang sama seperti variabel SUPABASE_* di atas.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [OPSIONAL] Supabase Service Role — hanya jika fitur admin/RLS bypass dipakai
# JANGAN diisi kalau tidak ada kode yang memanggil supabaseAdmin.
# Jika diisi, pastikan hanya server function internal yang menggunakannya.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [WAJIB] Runtime Node SSR
NODE_ENV=production
PORT=3000

# [WAJIB SAAT BUILD] Preset Nitro untuk server sendiri dengan NGINX
# Gunakan di command build, bukan sebagai variabel runtime tetap:
#   NITRO_PRESET=node-server npm run build
# NITRO_PRESET=node-server
