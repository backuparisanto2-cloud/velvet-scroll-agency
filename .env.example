# ============================================================
# CHECKLIST VARIABEL LINGKUNGAN
# Salin file ini menjadi .env lalu isi nilainya sebelum
# `npm run dev`, `npm run build`, atau `npm run export`.
# ============================================================

# [WAJIB] Backend untuk browser (ter-bundle saat build statis)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [WAJIB] Salinan nilai di atas — dipakai skrip validasi dan mode SSR (NGINX)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# OPSIONAL — hanya untuk deploy SSR dengan NGINX (lihat /nginx)
# Tidak diperlukan untuk hosting statis di Apache.
# ------------------------------------------------------------
# NODE_ENV=production
# PORT=3000
# NITRO_PRESET=node-server

# JANGAN pernah menaruh service-role key di file ini —
# semua variabel VITE_* ikut terkirim ke browser.
